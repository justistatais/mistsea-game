config_version=5
[application]
config/name="雾海档案：第七座灯塔"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[dotnet]
project/assembly_name="MistSea"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045,0.063,0.085,1)
[accessibility]
general/accessibility_support=1
