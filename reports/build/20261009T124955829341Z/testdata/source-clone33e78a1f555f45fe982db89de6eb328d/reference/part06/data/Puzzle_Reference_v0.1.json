  "families": [
    {
      "id": "A",
      "name": "版本与来源整合",
      "design": "核对身份、适用范围与修订关系；不是最新日期自动取胜",
      "ui": "版本板／比较架"
    },
    {
      "id": "B",
      "name": "时间与顺序重建",
      "design": "区分发生、记录与预定时间，允许偏序和未知",
      "ui": "时间轨道／步骤卡"
    },
    {
      "id": "C",
      "name": "空间与路线判断",
      "design": "把语言条件对应地标、历史线条与当前通路",
      "ui": "证据地图／路径草案"
    },
    {
      "id": "D",
      "name": "约束与资源安排",
      "design": "把容量、先后、对象与例外合成可行安排，不要求唯一最优",
      "ui": "分配板／行程表"
    },
    {
      "id": "E",
      "name": "设备与状态操作",
      "design": "根据说明改变真实设备，检查状态和配置版本",
      "ui": "实体机关／状态检查"
    },
    {
      "id": "F",
      "name": "主张与证据审查",
      "design": "区分支持、矛盾与不足，不凭身份判断诚实",
      "ui": "证据板／可说明范围"
    },
    {
      "id": "G",
      "name": "图表与试验推理",
      "design": "比较条件与结果、提出有限结论，不把相关当无限推广",
      "ui": "试验台／图表板"
    },
    {
      "id": "H",
      "name": "沟通与澄清",
      "design": "让真实接收者得到可执行意思，开放表达不开放改写事实",
      "ui": "现有通信与写作工作区"
    }
  ],
