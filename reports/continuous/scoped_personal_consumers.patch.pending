         Add("CP-R5-05","Actual zero-XP R4R5 arrival produces a native entry with local work untouched",()=>{using var s=Store("native-entry");var pair=ActualArrival(s);var v=Done(pair.Service.ViewAsync());Require(v.Snapshot.Balances["experience"]==6400&&v.Actor.Scene=="R5-S01"&&v.Materials.Length==0&&!v.State.Landing&&!v.State.MaraReleased&&!v.State.ResponsibilityScope&&v.Snapshot.Receipts.All(r=>!r.SemanticKey.StartsWith("fixture:",StringComparison.Ordinal)&&r.ActionType is not("explicit_engineering_fixture" or "internal_slice_initialization")));Done(s.CreateCheckpointAsync("manual"));File.WriteAllText(Path.Combine(Path.GetDirectoryName(s.MainPath)!,"normal-r5-native-entry.json"),StrictJson.Serialize(new{scope="actual zero-XP through Q404 and actual R4R5 voyage; R5 only initialized with no local source/device/rescue/reward action",experience=6400,profile_path=s.MainPath,actor=v.Actor,receipts=v.Snapshot.Receipts,native_human="pending",language_review="human_pending",audio="not_recorded"}));});
         Add("CP-R5-05","Actual zero-XP mainline completes R5 with one vessel, one original case, alive mentor and bounded R6 commission",()=>{using var s=Store("normal-complete");NormalComplete(s);var final=Done(s.SnapshotAsync());var hand=Read<OldCityHandover>(s,"R5:actual_handover");Require(final.Balances["experience"]==10500&&final.Entities.Count(e=>e.Kind=="shared_vessel")==1&&final.Items.Count(i=>i.Id==ChapterFiveService.OriginalCase)==1&&hand is{Destination:"R6",MaraCurrentStatus:"rescued_alive_directly_verified",PolicyDecision:"not_selected"}&&ChapterFiveService.MainQuests.All(q=>final.Receipts.Count(r=>r.SemanticKey==q+":resolution")==1)&&final.Receipts.All(r=>!r.SemanticKey.StartsWith("fixture:",StringComparison.Ordinal)&&r.ActionType is not("explicit_engineering_fixture" or "internal_slice_initialization")));File.WriteAllText(Path.Combine(Path.GetDirectoryName(s.MainPath)!,"normal-r5-main.json"),StrictJson.Serialize(new{scope="actual zero-XP through preceding mainline, actual voyage and R5 route/rescue/review/tower/custody/handover",experience=10500,receipts=final.Receipts,handover=hand,audio="not_recorded",native_human="pending",language_review="pending"}));});
