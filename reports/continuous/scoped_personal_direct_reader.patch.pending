@@ -54,1 +54,1 @@
-    {var s=await _repository.SnapshotAsync();Require(BranchOperations.Read<ChapterFourState>(s,"chapter4") is{MiraReviewInvited:true},"当前访问邀请已撤回。");var a=BranchOperations.Read<ActualMiraRenewalAnswer>(s,"personal-detail:mira02-expansion")??throw new InvalidOperationException("尚未提出并取得本次实际应答。");Require(a.NodeInstance==Quest(s,"CQ-MIRA-02").Instance&&s.Receipts.Any(r=>r.ActionType=="mira_paper_scope_expansion_answered"&&r.ResultJson==StrictJson.Serialize(a)),"当前应答来源不符。");return Package.Responses.Single(r=>r.Fingerprint==a.ResponseHash);}
